+/* HolyC bridge state (read-only, lightweight). */
+void hmp_holyc_bridge(Monitor *mon, const QDict *qdict)
+{
+    void *env;
+    uint64_t base, irq_count, last_cmd, last_status;
+    bool active;
+
+    (void)qdict;
+    holyc_bridge_state_snapshot(&env, &base, &active,
+                                &irq_count, &last_cmd, &last_status);
+    monitor_printf(mon,
+                   "holyc-bridge: env=%p active=%d mailbox_base=0x%" PRIx64
+                   " irq_count=%" PRIu64 " last_cmd=%" PRIu64
+                   " last_status=%" PRIu64 "\n",
+                   env, active, base, irq_count, last_cmd, last_status);
+}
